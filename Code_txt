#!/usr/bin/env python3
"""
bundle.py — pack an entire project into ONE text file, and decode/execute it back.

The single text file is a self-describing, base64-encoded snapshot of every file in
the project (text and binary alike). It can be emailed, pasted, or version-controlled
as plain text, then decoded to reconstruct the project byte-for-byte.

USAGE
-----
Pack a directory into one text file:
    python bundle.py pack  [SRC_DIR] [-o OUTPUT.txt]

Decode a text file back into a directory:
    python bundle.py unpack BUNDLE.txt [-d DEST_DIR]

Decode AND run a command inside the reconstructed directory ("execute it"):
    python bundle.py unpack BUNDLE.txt -d DEST_DIR --run "npm install && npm run build"

List the contents of a bundle without writing anything:
    python bundle.py list BUNDLE.txt

Examples (from inside site_react/):
    python bundle.py pack . -o site_react.bundle.txt
    python bundle.py unpack site_react.bundle.txt -d ../site_react_restored
    python bundle.py unpack site_react.bundle.txt -d ./restored --run "python -m http.server"

NOTES
-----
* Directories in IGNORE (node_modules, dist, .git, ...) are skipped when packing.
* Each file is base64-encoded, so binary assets survive a round-trip intact.
* A SHA-256 checksum per file is stored and verified on unpack.
* The bundle format is line-oriented text: a JSON header line, then one line per
  file ("<relpath>\t<sha256>\t<base64>"). Easy to diff and inspect.
"""

from __future__ import annotations  # allow "str | None" hints on Python 3.9

import argparse
import base64
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
MAGIC = "PYBUNDLE/v1"

# Directory names skipped entirely when packing.
IGNORE_DIRS = {
    "node_modules", "dist", ".git", ".svn", ".hg", "__pycache__",
    ".vite", ".cache", ".idea", ".vscode", "build", ".next", "coverage",
}

# Exact filenames skipped when packing.
IGNORE_FILES = {
    ".DS_Store", "Thumbs.db",
}

# File suffixes skipped (secrets / local-only).
IGNORE_SUFFIXES = (
    ".env.local", ".log",
)


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _should_skip(relpath: str, name: str) -> bool:
    if name in IGNORE_FILES:
        return True
    return any(relpath.endswith(suf) for suf in IGNORE_SUFFIXES)


def _iter_files(src_dir: str):
    """Yield (relpath, abspath) for every packable file under src_dir."""
    src_dir = os.path.abspath(src_dir)
    for root, dirs, files in os.walk(src_dir):
        # Prune ignored directories in-place so os.walk doesn't descend into them.
        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS]
        for name in sorted(files):
            abspath = os.path.join(root, name)
            relpath = os.path.relpath(abspath, src_dir).replace(os.sep, "/")
            if _should_skip(relpath, name):
                continue
            # Don't pack the bundle output into itself.
            yield relpath, abspath


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
def cmd_pack(src_dir: str, output: str) -> None:
    src_dir = os.path.abspath(src_dir)
    output_abs = os.path.abspath(output)
    if not os.path.isdir(src_dir):
        sys.exit(f"error: source is not a directory: {src_dir}")

    entries = []
    total_bytes = 0
    for relpath, abspath in _iter_files(src_dir):
        if os.path.abspath(abspath) == output_abs:
            continue  # never include the bundle in itself
        with open(abspath, "rb") as fh:
            data = fh.read()
        total_bytes += len(data)
        entries.append(
            (relpath, _sha256(data), base64.b64encode(data).decode("ascii"))
        )

    header = {
        "magic": MAGIC,
        "created": datetime.now(timezone.utc).isoformat(),
        "source": os.path.basename(src_dir),
        "file_count": len(entries),
        "total_bytes": total_bytes,
    }

    with open(output, "w", encoding="utf-8", newline="\n") as out:
        out.write(json.dumps(header) + "\n")
        for relpath, digest, b64 in entries:
            out.write(f"{relpath}\t{digest}\t{b64}\n")

    print(f"Packed {len(entries)} files ({total_bytes:,} bytes) -> {output}")
    print(f"Bundle size on disk: {os.path.getsize(output):,} bytes")


def _read_bundle(bundle_path: str):
    """Return (header_dict, [(relpath, sha, bytes), ...])."""
    if not os.path.isfile(bundle_path):
        sys.exit(f"error: bundle not found: {bundle_path}")
    with open(bundle_path, "r", encoding="utf-8") as fh:
        first = fh.readline()
        try:
            header = json.loads(first)
        except json.JSONDecodeError:
            sys.exit("error: not a valid bundle (bad header line)")
        if header.get("magic") != MAGIC:
            sys.exit(f"error: unrecognized bundle magic: {header.get('magic')!r}")

        files = []
        for lineno, line in enumerate(fh, start=2):
            line = line.rstrip("\n")
            if not line:
                continue
            try:
                relpath, digest, b64 = line.split("\t", 2)
            except ValueError:
                sys.exit(f"error: malformed entry on line {lineno}")
            data = base64.b64decode(b64.encode("ascii"))
            if _sha256(data) != digest:
                sys.exit(f"error: checksum mismatch for {relpath}")
            files.append((relpath, digest, data))
    return header, files


def cmd_list(bundle_path: str) -> None:
    header, files = _read_bundle(bundle_path)
    print(f"Bundle: {bundle_path}")
    print(f"  created : {header.get('created')}")
    print(f"  source  : {header.get('source')}")
    print(f"  files   : {header.get('file_count')}")
    print(f"  bytes   : {header.get('total_bytes'):,}")
    print("-" * 60)
    for relpath, _digest, data in files:
        print(f"  {len(data):>10,}  {relpath}")


def cmd_unpack(bundle_path: str, dest_dir: str, run: str | None) -> None:
    header, files = _read_bundle(bundle_path)
    dest_dir = os.path.abspath(dest_dir)
    os.makedirs(dest_dir, exist_ok=True)

    for relpath, _digest, data in files:
        target = os.path.join(dest_dir, relpath.replace("/", os.sep))
        # Guard against path traversal from a malicious bundle.
        if not os.path.abspath(target).startswith(dest_dir + os.sep) and os.path.abspath(target) != dest_dir:
            sys.exit(f"error: unsafe path in bundle: {relpath}")
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as fh:
            fh.write(data)

    print(f"Unpacked {len(files)} files -> {dest_dir}")

    if run:
        print(f"\n--- executing: {run} ---")
        # Run through the shell inside the reconstructed directory.
        result = subprocess.run(run, shell=True, cwd=dest_dir)
        sys.exit(result.returncode)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def main(argv=None) -> None:
    parser = argparse.ArgumentParser(
        description="Pack a project into one text file, and decode/execute it back.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_pack = sub.add_parser("pack", help="pack a directory into a single text file")
    p_pack.add_argument("src", nargs="?", default=".", help="source directory (default: .)")
    p_pack.add_argument("-o", "--output", default="bundle.txt", help="output text file")

    p_unpack = sub.add_parser("unpack", help="decode a bundle back into a directory")
    p_unpack.add_argument("bundle", help="bundle text file")
    p_unpack.add_argument("-d", "--dest", default="unpacked", help="destination directory")
    p_unpack.add_argument("--run", default=None, help="shell command to execute after unpacking")

    p_list = sub.add_parser("list", help="list a bundle's contents")
    p_list.add_argument("bundle", help="bundle text file")

    args = parser.parse_args(argv)

    if args.command == "pack":
        cmd_pack(args.src, args.output)
    elif args.command == "unpack":
        cmd_unpack(args.bundle, args.dest, args.run)
    elif args.command == "list":
        cmd_list(args.bundle)


if __name__ == "__main__":
    main()
How to run
What I built: bundle.py
A self-contained CLI that packs the entire project into one text file and can decode + execute it back — with byte-for-byte integrity.

The three commands
Pack — walk the project, base64-encode every file (text and binary), write one text file:


py bundle.py pack . -o site_react.bundle.txt
List — inspect a bundle without writing anything:


py bundle.py list site_react.bundle.txt
Unpack (decode) + execute — reconstruct the directory, then run a command in it:


py bundle.py unpack site_react.bundle.txt -d ./restored --run "npm install && npm run build"
How it works
One text file: a JSON header line, then one line per file — <relpath>\t<sha256>\t<base64>. Plain text, diff-able, paste-able.
Decoding: base64-decodes each entry back to bytes and rewrites the exact tree.
"Execute it": --run runs any shell command inside the reconstructed folder.
Integrity: a SHA-256 per file, verified on unpack (mismatch aborts).
Safety: skips node_modules/dist/.git/.env.local, refuses path-traversal entries, never packs the bundle into itself.
