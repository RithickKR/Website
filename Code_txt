	width: 320px !important;
	position: absolute;
	left: -100%;
	top: 100%;
	margin-top: 1px;
	z-index: 3;
	background: rgba(19, 18, 19, 1);
	height: calc(100vh - 52px);
	transition: .3s ease-in-out;
	opacity: 0;
}

header.header-scroll .nav-menu {
	background: rgba(19, 18, 19, 1);
}

.nav-menu.active {
	left: 0;
	opacity: 1;
}

