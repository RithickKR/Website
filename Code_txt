            const activeItem = pagination.querySelector('.pagination-item.active');
            let activeIndex = -1;

            if (activeItem) {
                const activeLink = activeItem.querySelector('a');
                if (activeLink) {
                    const activeHref = activeLink.getAttribute('href');
                    activeIndex = pages.findIndex(p => p.href === activeHref);
                }
            }

            if (activeIndex === -1) {
                const currentPage = window.location.pathname.split("/").pop();
                activeIndex = pages.findIndex(p => p.href === currentPage);
            }

            if (activeIndex === -1) activeIndex = 1;

            // Circular calculation of prev/next
            const prevIndex = (activeIndex === 0) ? pages.length - 1 : activeIndex - 1;
            const nextIndex = (activeIndex === pages.length - 1) ? 0 : activeIndex + 1;

            const prevLink = pagination.querySelector('.item-prev a');
            const nextLink = pagination.querySelector('.item-next a');

            if (prevLink) {
                prevLink.href = pages[prevIndex].href;
            }
            if (nextLink) {
                nextLink.href = pages[nextIndex].href;
            }

